{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Credit LK — симулятор внешних источников",
    "description": "\nЛокальные заменители внешних сервисов. Все данные синтетические.\n\n**Доступ:** заголовок `X-Api-Key` (переменная `MOCKS_API_KEY`) → кнопка *Authorize*.\n\n**Поведение источников** меняется через `PUT /admin/sources/{source}`:\n`normal` — ответ с задержкой, `error` — 503, `timeout` — зависание и 504.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Служебное"
        ],
        "summary": "Проверка работоспособности",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/egr/v1/extracts/{inn}": {
      "get": {
        "tags": [
          "ЕГРЮЛ / ЕГРИП"
        ],
        "summary": "Выписка из ЕГРЮЛ (10-значный ИНН) или ЕГРИП (12-значный ИНН)",
        "operationId": "extract_egr_v1_extracts__inn__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "inn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{10}(\\d{2})?$",
              "examples": [
                "1655482318"
              ],
              "title": "Inn"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EgrExtract"
                }
              }
            }
          },
          "404": {
            "description": "Сведения не найдены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/nbki/v1/credit-reports": {
      "post": {
        "tags": [
          "НБКИ"
        ],
        "summary": "Кредитный отчёт по ИНН",
        "description": "Если кредитной истории нет, возвращается отчёт с historyFound=false — это результат, а не ошибка.",
        "operationId": "credit_report_nbki_v1_credit_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreditReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditReport"
                }
              }
            }
          },
          "400": {
            "description": "Неверный запрос",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Нет действующего согласия субъекта",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/pb/v1/companies/{inn}": {
      "get": {
        "tags": [
          "ФНС «Прозрачный бизнес»"
        ],
        "summary": "Сведения о компании или ИП по ИНН",
        "operationId": "company_pb_v1_companies__inn__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "inn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{10}(\\d{2})?$",
              "examples": [
                "5406247181"
              ],
              "title": "Inn"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PbProfile"
                }
              }
            }
          },
          "404": {
            "description": "Сведения не найдены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/sources": {
      "get": {
        "tags": [
          "Управление симулятором"
        ],
        "summary": "Текущее поведение источников",
        "operationId": "sources_admin_sources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/SourceBehavior"
                  },
                  "propertyNames": {
                    "$ref": "#/components/schemas/Source"
                  },
                  "type": "object",
                  "title": "Response Sources Admin Sources Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/admin/sources/{source}": {
      "put": {
        "tags": [
          "Управление симулятором"
        ],
        "summary": "Изменить поведение источника",
        "description": "Например, `{\"mode\": \"error\"}` — источник недоступен; `{\"mode\": \"normal\"}` — вернуть как было.",
        "operationId": "update_source_admin_sources__source__put",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Source"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceBehaviorUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceBehavior"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/reset": {
      "post": {
        "tags": [
          "Управление симулятором"
        ],
        "summary": "Сбросить поведение и журнал",
        "operationId": "reset_admin_reset_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/admin/requests": {
      "get": {
        "tags": [
          "Управление симулятором"
        ],
        "summary": "Последние запросы к источникам",
        "operationId": "requests_admin_requests_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JournalEntry"
                  },
                  "title": "Response Requests Admin Requests Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
