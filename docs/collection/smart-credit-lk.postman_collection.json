    {
      "name": "2. Подбор продукта",
      "description": "Компания известна банку — реквизиты не вводятся. Подбор — по правилам, без ИИ.",
      "item": [
        {
          "name": "Компания клиента",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/me/company"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"name = ООО «Продмаркет»\", () => pm.expect(pm.response.json().name).to.eql(\"ООО «Продмаркет»\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Каталог продуктов",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"3 продукта\", () => pm.expect(pm.response.json()).to.have.length(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Справочники",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dictionaries"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Есть причины недоступности\", () => pm.expect(pm.response.json().unavailableReasons).to.not.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Подбор: кассовый разрыв 400 000 ₽ на 12 мес.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/assistant/recommend",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"cash_gap\",\n  \"amount\": 400000,\n  \"termMonths\": 12,\n  \"collateral\": \"none\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"items[0].product.id = overdraft\", () => pm.expect(pm.response.json().items[0].product.id).to.eql(\"overdraft\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Заявка клиента",
      "description": "Черновик → изменения → подача с согласиями. Повторная подача с тем же Idempotency-Key не создаёт дубль.",
      "item": [
        {
          "name": "Создать черновик",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"working-capital\",\n  \"purpose\": \"working_capital\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status = draft\", () => pm.expect(pm.response.json().status).to.eql(\"draft\"));",
                  "pm.collectionVariables.set(\"applicationId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Заполнить черновик",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000000,\n  \"termMonths\": 12,\n  \"contact\": {\n    \"name\": \"Гарипов Рустам Ильдарович\",\n    \"phone\": \"+7 (843) 000-27-14\",\n    \"email\": \"finance@prodmarket.example\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"amount = 1000000\", () => pm.expect(pm.response.json().amount).to.eql(1000000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Подать без согласия на БКИ — ошибка",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consents\": {\n    \"bki\": false,\n    \"personalData\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Код ошибки validation_error\", () => pm.expect(pm.response.json().error.code).to.eql(\"validation_error\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Подать заявку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consents\": {\n    \"bki\": true,\n    \"personalData\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"status = submitted\", () => pm.expect(pm.response.json().status).to.eql(\"submitted\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Повторная подача тем же ключом — тот же результат",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consents\": {\n    \"bki\": true,\n    \"personalData\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Та же заявка\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"applicationId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Изменить поданную заявку нельзя",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications/{{applicationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Код ошибки not_draft\", () => pm.expect(pm.response.json().error.code).to.eql(\"not_draft\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Мои заявки",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Заявка (клиентская проекция)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications/A-1024"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Нет внутренних данных банка\", () => { const b = pm.response.json(); [\"score\", \"scoringInputs\", \"systemRecommendation\", \"rateBreakdown\"].forEach(k => pm.expect(b).to.not.have.property(k)); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Сделка по контрпредложению (A-1024)",
      "description": "Принять предложение → код подписи (в демо-режиме приходит в ответе) → подписание → выдача.",
      "item": [
        {
          "name": "Принять предложение",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications/A-1024/offer/accept"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status = signing\", () => pm.expect(pm.response.json().status).to.eql(\"signing\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить код подписи",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications/A-1024/sign/code"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"signCode\", pm.response.json().code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Неверный код",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications/A-1024/sign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{wrongCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Код ошибки invalid_code\", () => pm.expect(pm.response.json().error.code).to.eql(\"invalid_code\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"wrongCode\", pm.collectionVariables.get(\"signCode\") === \"000000\" ? \"111111\" : \"000000\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Подписать договор",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": "{{baseUrl}}/applications/A-1024/sign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{signCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status = issued\", () => pm.expect(pm.response.json().status).to.eql(\"issued\"));",
                  "pm.test(\"issuance.amount = 1500000\", () => pm.expect(pm.response.json().issuance.amount).to.eql(1500000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Аналитик (A-1025)",
      "description": "Очередь, полная карточка, повторный запрос данных из источников, решение. Затем клиент принимает контрпредложение.",
      "item": [
        {
          "name": "Очередь заявок",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              }
            ],
            "url": "{{baseUrl}}/analyst/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Очередь: только ручная проверка",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystToken}}"
              }
            ],
            "url": "{{baseUrl}}/analyst/applications?status=manual_review"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
