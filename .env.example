# Шаблон переменных окружения.
# Для запуска в Docker файл .env не обязателен - у всех переменных есть значения по умолчанию.
# Чтобы переопределить значения: cp .env.example .env и отредактировать.
# Настоящий .env в репозиторий не коммитится.

# --- Режим работы ---
ENVIRONMENT=docker
# Демо-режим: список тестовых учёток и сброс демо-данных
DEMO_MODE=true
# Показывать код подписи договора в ответе API (только для демонстрации)
DEMO_SHOW_SIGN_CODE=true

# --- Авторизация ---
# Секрет подписи JWT: не короче 32 символов, на сервере — обязательно свой
JWT_SECRET=docker-dev-secret-code-0123456789abcdef
JWT_TTL_MINUTES=480

# --- База данных ---
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit

# --- Порты на хосте ---
API_PORT=8000
