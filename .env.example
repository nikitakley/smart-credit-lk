# Шаблон переменных окружения.
# Для запуска в Docker файл .env не обязателен — у всех переменных есть значения по умолчанию.
# Чтобы переопределить значения: cp .env.example .env и отредактировать.
# Настоящий .env в репозиторий не коммитится.

# --- Режим работы ---
ENVIRONMENT=docker
# Демо-режим: список тестовых учёток и сброс демо-данных
DEMO_MODE=true
# Показывать код подписи договора в ответе API (только для демонстрации)
DEMO_SHOW_SIGN_CODE=true

# --- Авторизация ---
# Секрет подписи JWT: не короче 32 символов, на сервере — обязательно свой
JWT_SECRET=docker-dev-secret-code-0123456789abcdef
JWT_TTL_MINUTES=480

# --- База данных ---
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
# Порт базы на этом компьютере (для локального запуска API без Docker)
POSTGRES_PORT=5432

# --- Внешние источники (симулятор mocks) ---
# Ключ доступа к симулятору; бэкенд получает его как INTEGRATION_API_KEY
MOCKS_API_KEY=local-mocks-key
# Задержка ответа источников, мс (случайная в диапазоне) и доля случайных сбоев (0 — нет, 1 — всегда)
MOCK_LATENCY_MIN_MS=300
MOCK_LATENCY_MAX_MS=1200
MOCK_FAILURE_RATE=0
# Сколько бэкенд ждёт ответа одной попытки, с, и сколько раз повторяет запрос
INTEGRATION_TIMEOUT_SECONDS=3
INTEGRATION_RETRIES=2

# --- Порты на хосте ---
API_PORT=8000
# Swagger симулятора: http://localhost:8001/docs
MOCKS_PORT=8001

# --- Только для запуска без Docker (uvicorn и pytest из папки backend) ---
# Docker эти переменные не использует. Задаются переменными окружения перед командой, например:
#   TEST_DATABASE_URL=postgresql+psycopg://credit:credit@localhost:5433/credit_test uv run pytest
# Адрес рабочей базы (по умолчанию postgresql+psycopg://credit:credit@localhost:5432/credit):
# DATABASE_URL=postgresql+psycopg://credit:credit@localhost:5432/credit
# Адрес базы для тестов — имя обязано оканчиваться на _test, база создаётся автоматически:
# TEST_DATABASE_URL=postgresql+psycopg://credit:credit@localhost:5432/credit_test
